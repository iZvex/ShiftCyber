<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_compact_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@drawable/widget_bg_translucent">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="SHIFT CYBER"
        android:textStyle="bold"
        android:textColor="#BDA2FF"
        android:textSize="10sp"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/widget_compact_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="График смен"
        android:textColor="#F6F3FF"
        android:textSize="14sp"
        android:textStyle="bold"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/widget_compact_details"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="2dp"
        android:text="Открой приложение"
        android:textColor="#65E7F2"
        android:textSize="11sp"
        android:includeFontPadding="false"
        android:maxLines="2"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/widget_compact_earnings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="— ₽"
        android:textColor="#72F0B2"
        android:textSize="15sp"
        android:textStyle="bold"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:ellipsize="end" />

</LinearLayout>
